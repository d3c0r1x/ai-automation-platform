# ── Хранилище ───────────────────────────────────────────────────────────────
# Локально и в тестах: sqlite:///./data/aap.db
# Прод (docker-compose): postgresql://aap:aap@postgres:5432/aap
AAP_DATABASE_URL=sqlite:///./data/aap.db

# ── Очередь ─────────────────────────────────────────────────────────────────
# memory — очередь внутри процесса (демо, тесты, одиночный запуск)
# redis  — отдельный воркер, можно масштабировать
AAP_QUEUE=memory
AAP_REDIS_URL=redis://localhost:6379/0
AAP_QUEUE_NAME=aap:tasks

# ── LLM (любой OpenAI-совместимый эндпоинт) ─────────────────────────────────
# Без этих двух переменных платформа работает на детерминированном планировщике:
# все шаги те же, но план строится кодом, а не моделью.
# OpenRouter: https://openrouter.ai/api/v1 | Ollama: http://localhost:11434/v1
AAP_LLM_BASE_URL=
AAP_LLM_API_KEY=
AAP_LLM_MODEL=gpt-4o-mini
AAP_LLM_TIMEOUT=60

# ── Инструменты ─────────────────────────────────────────────────────────────
# Внешний API поиска товаров. Контракт: GET {base}/search?q=&limit=&max_price=
# → {"items": [{"id","title","price","rating","reviews","marketplace","url"}]}
# Пусто — используется встроенный демо-каталог (детерминированный, без сети).
AAP_MARKETPLACE_BASE_URL=
AAP_MARKETPLACE_API_KEY=

# Браузерный канал: Playwright, при недоступности — обычный HTTP GET
AAP_BROWSER_ENABLED=1

# Доставка отчёта
AAP_TELEGRAM_BOT_TOKEN=
AAP_TELEGRAM_CHAT_ID=

# ── Поведение исполнителя ───────────────────────────────────────────────────
AAP_STEP_RETRIES=2
AAP_STEP_TIMEOUT=45
AAP_MAX_STEPS=12
# 1 — шаги, уходящие наружу (отправка отчёта), ждут подтверждения человека
AAP_REQUIRE_APPROVAL=1
AAP_SSE_INTERVAL=0.5
